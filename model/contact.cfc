<cfcomponent persistent="true" table="contact" entityname="Contact">
    <cfproperty name="userId" fieldtype="id" generator="native">
    <cfproperty name="img">
    <cfproperty name="title">
    <cfproperty name="firstName">
    <cfproperty name="lastName">
    <cfproperty name="mail">
    <cfproperty name="phone">
    <cfproperty name="createdBy">
    <cfproperty name="IsActive">
</cfcomponent>
